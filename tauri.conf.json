{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentSync",
  "version": "0.2.0",
  "identifier": "dev.agentsync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentSync",
        "width": 1380,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Browse and sync coding-agent skills and chats",
    "longDescription": "A private-first desktop app for browsing and synchronizing Codex resources."
  }
}
