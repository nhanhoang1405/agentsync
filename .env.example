# Local compose database. Never use this password in a deployed environment.
AGENTSYNC_DATABASE_URL=postgres://agentsync:agentsync-dev-only@localhost:55432/agentsync

# Override the host port if 55432 is already occupied.
# AGENTSYNC_POSTGRES_PORT=55432

# For libsql:// Turso connections, provide a database auth token separately.
# TURSO_AUTH_TOKEN=your-database-auth-token
